# Copie para .env (nunca commitado — ver .gitignore) e preencha com
# valores reais. Nenhum valor real deve ir neste arquivo de exemplo.

# --- Asaas (pagamento) ---
# Gerar em: painel do Asaas -> Configurações -> Integrações -> API Key
ASAAS_API_KEY=
# "sandbox" (padrão, recomendado pra testar antes) ou "production"
ASAAS_ENV=sandbox
# Configurar em: painel do Asaas -> Integrações -> Webhooks -> Token de acesso
# (a mesma URL do webhook, /api/webhooks/asaas, precisa ser cadastrada lá)
ASAAS_WEBHOOK_TOKEN=

# --- E-mail de notificação de pedido (via @lovable.dev/email-js) ---
# Se o site estiver publicado pela Lovable, essa chave pode já vir
# provisionada automaticamente pela plataforma — conferir antes de gerar uma.
LOVABLE_API_KEY=
# E-mail do cliente que deve receber o resumo de cada pedido confirmado
NOTIFY_EMAIL=
